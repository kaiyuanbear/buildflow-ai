{
  "name": "@buildflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "qa": "tsx src/qa.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@buildflow/contracts": "workspace:*",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/static": "^10.1.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.2.1",
    "postgres": "^3.4.9",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
